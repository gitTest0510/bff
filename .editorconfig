root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[pom.xml]
indent_style = tab

# Java は Spotless（google-java-format の GOOGLE スタイル）に合わせる
[*.{java,json,yml,yaml}]
indent_size = 2

[*.cmd]
end_of_line = crlf
